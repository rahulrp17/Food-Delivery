# Backend runtime configuration.
#
# Copy this file to .env and fill in the values. Everything is validated by
# backend/src/config/env.js: an unknown or malformed value fails at boot
# instead of surfacing later as a broken request.
#
# The pre-v1 API (/api/user, /api/food, /api/cart, /api/orders) has been
# removed and always answers 410. Only /api/v1 is served.

NODE_ENV=development
PORT=4000

# Connection string. Required outside the test run.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-with-node-crypto>

# The storefront origin. Used for CORS, the CSRF origin check and the Stripe
# success/cancel redirects.
CLIENT_URL=http://localhost:5173
# Extra allowed origins, comma separated. Add the deployed frontend here.
ADDITIONAL_ORIGINS=
# Leave empty locally. Set the shared domain (e.g. .foodie.local) in production
# so the session cookie is sent to every host of the site.
COOKIE_DOMAIN=
# Set to true behind a proxy (Render, Heroku, Nginx) so the client IP is read
# from X-Forwarded-For and the rate limits are not shared by every visitor.
TRUST_PROXY=false

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Required when NODE_ENV=production.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here

# Uploads are written to backend/uploads with the local driver.
STORAGE_DRIVER=local
CLOUDINARY_URL=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Credentials of the seeded admin account (npm run seed:admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Script flag: set to 1 to re-download the category images during
# `npm run migrate:chicken`.
REFRESH_CATEGORY_IMAGES=
