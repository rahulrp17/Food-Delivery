PORT=4000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-with-node-crypto>

CLIENT_URL=http://localhost:5173
ADDITIONAL_ORIGINS=
COOKIE_DOMAIN=
TRUST_PROXY=false

# The pre-v1 API (/api/user, /api/food, /api/cart, /api/orders) has been
# removed and always answers 410. Only /api/v1 is served.

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here

STORAGE_DRIVER=local
CLOUDINARY_URL=

LOG_LEVEL=info

ADMIN_EMAIL=
ADMIN_PASSWORD=
