# Base URL of the backend API.
#
# Leave this as "/api/v1" for local development and for the Vite preview
# server: both proxy /api and /images to http://localhost:4000 (see
# vite.config.js), so cookies stay same-origin and the CSRF flow works.
#
# In production set an absolute URL to the deployed backend, e.g.
#   VITE_API_URL=https://api.example.com/api/v1
# The deployment must also proxy /images to the backend, because product
# image paths are returned relative to the API origin (/images/<file>).
VITE_API_URL=/api/v1
